{
  "$description": "Shortcut design tokens — single source of truth. Run `node design/build-tokens.mjs` to regenerate CSS for the app and the landing page.",
  "color": {
    "primary": "#3B82F6",
    "primary-strong": "#1D4ED8",
    "primary-soft": "#EFF6FF",
    "primary-ring": "rgba(59, 130, 246, 0.35)",
    "secondary": "#FFFFFF",
    "accent": "#EF4444",
    "accent-strong": "#B91C1C",
    "accent-soft": "#FEF2F2",
    "warning": "#B45309",
    "warning-soft": "#FFFBEB",
    "success": "#15803D",
    "success-soft": "#F0FDF4",
    "background": "#FFFFFF",
    "surface": "#FFFFFF",
    "surface-muted": "#F9FAFB",
    "surface-sunken": "#F3F4F6",
    "text-primary": "#111827",
    "text-secondary": "#4B5563",
    "text-muted": "#6B7280",
    "border": "#E5E7EB",
    "border-strong": "#D1D5DB"
  },
  "font": {
    "display": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "body": "\"Playfair Display\", Georgia, \"Times New Roman\", serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "type": {
    "display-lg": { "size": "64px", "weight": "500", "line-height": "1.04", "letter-spacing": "0" },
    "display-md": { "size": "44px", "weight": "500", "line-height": "1.08", "letter-spacing": "0" },
    "heading": { "size": "28px", "weight": "500", "line-height": "1.2", "letter-spacing": "0" },
    "title": { "size": "18px", "weight": "600", "line-height": "1.3", "letter-spacing": "0" },
    "body-lg": { "size": "19px", "weight": "400", "line-height": "1.6", "letter-spacing": "0" },
    "body-md": { "size": "16px", "weight": "400", "line-height": "1.6", "letter-spacing": "0" },
    "ui": { "size": "14px", "weight": "500", "line-height": "1.4", "letter-spacing": "0" },
    "label-md": { "size": "12px", "weight": "600", "line-height": "1.2", "letter-spacing": "0.06em" }
  },
  "space": {
    "base": "8px",
    "1": "8px",
    "2": "16px",
    "3": "24px",
    "4": "32px",
    "5": "40px",
    "6": "48px",
    "8": "64px",
    "10": "80px",
    "gap": "16px",
    "card-padding": "24px",
    "section-padding": "80px"
  },
  "radius": {
    "card": "23px",
    "control": "23px",
    "inner": "14px",
    "pill": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(17, 24, 39, 0.06)",
    "md": "0 1px 2px rgba(17, 24, 39, 0.04), 0 12px 32px -16px rgba(17, 24, 39, 0.20)",
    "lg": "0 2px 6px rgba(17, 24, 39, 0.05), 0 32px 64px -28px rgba(17, 24, 39, 0.32)",
    "focus": "0 0 0 4px rgba(59, 130, 246, 0.25)"
  },
  "motion": {
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "fast": "150ms",
    "base": "300ms",
    "slow": "700ms"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "900px",
    "lg": "1200px"
  }
}
