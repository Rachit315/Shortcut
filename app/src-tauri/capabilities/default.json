{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Clazy windows may call Clazy's own commands, listen to its events, and open file dialogs.",
  "windows": ["main", "palette"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
